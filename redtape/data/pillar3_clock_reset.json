    {
      "id": "pre_acceptance_eds_reset",
      "title": "Clock resets to zero at `accepted_on` / final EDS reply",
      "detail": "Direct CAF ground-truth verification proves that whenever EDS rounds occur, PARIVESH computes `(grant_date - last_submission_date) - adsDays`, erasing 100% of prior government scrutiny (`gov_scrutiny_before_last_eds_days`)."
    },
    {
      "id": "null_on_fc_wlc_crz_pending",
      "title": "100% `null` on Forest, Wildlife, CRZ, Auto-ToR & all Pending/Rejected filings",
      "detail": "`proponentApplications.proposal_duration` is populated only on granted appraised EC/ToR rows, leaving Forest, Wildlife, CRZ, and active backlogs invisible to official averages."
    },
    {
      "id": "db_timestamp_anomalies",
      "title": "Multi-hour/multi-day database timestamp overlaps & manual shifts (871 proposals flagged)",
      "detail": "Includes recalled-step pre-recall `start_date` reuse, mid-workflow draft `created_on` reuse, and manual retroactive `start_date` edits documented in officer remarks \u2014 all normalized cleanly via monotonic cursor clamping."
    }
  ],
