{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/snapshot"
    },
    {
      "source": "/copwatchindia",
      "destination": "https://copwatchindia.vercel.app/"
    },
    {
      "source": "/copwatchindia/",
      "destination": "https://copwatchindia.vercel.app/"
    },
    {
      "source": "/copwatchindia/:path*",
      "destination": "https://copwatchindia.vercel.app/:path*"
    },
    {
      "source": "/apwatch",
      "destination": "https://copwatchindia.vercel.app/apwatch/"
    },
    {
      "source": "/apwatch/",
      "destination": "https://copwatchindia.vercel.app/apwatch/"
    },
    {
      "source": "/apwatch/:path*",
      "destination": "https://copwatchindia.vercel.app/apwatch/:path*"
    },
    {
      "source": "/babuwatch",
      "destination": "/babuwatch/"
    },
    {
      "source": "/copwatch",
      "destination": "/babuwatch/copwatch/"
    },
    {
      "source": "/copwatch/",
      "destination": "/babuwatch/copwatch/"
    },
    {
      "source": "/sin",
      "destination": "/babuwatch/sin/"
    },
    {
      "source": "/sin/",
      "destination": "/babuwatch/sin/"
    },
    {
      "source": "/fos",
      "destination": "/babuwatch/fos/"
    },
    {
      "source": "/fos/",
      "destination": "/babuwatch/fos/"
    }
  ]
}