{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/snapshot"
    },
    {
      "source": "/sin",
      "destination": "/babuwatch/sin/"
    },
    {
      "source": "/sin/",
      "destination": "/babuwatch/sin/"
    },
    {
      "source": "/fos",
      "destination": "/babuwatch/fos/"
    },
    {
      "source": "/fos/",
      "destination": "/babuwatch/fos/"
    }
  ],
  "redirects": [
    {
      "source": "/copwatchindia",
      "destination": "/babuwatch/tracker?service=police",
      "permanent": false
    },
    {
      "source": "/copwatchindia/report",
      "destination": "/babuwatch#seek-remedy",
      "permanent": true
    },
    {
      "source": "/copwatchindia/volunteer",
      "destination": "/babuwatch/about",
      "permanent": true
    },
    {
      "source": "/copwatchindia/:path*",
      "destination": "/babuwatch/:path*",
      "permanent": true
    },
    {
      "source": "/copwatch",
      "destination": "/babuwatch/tracker?service=police",
      "permanent": false
    },
    {
      "source": "/copwatch/:path*",
      "destination": "/babuwatch/:path*",
      "permanent": true
    },
    {
      "source": "/babuwatch/copwatchindia",
      "destination": "/babuwatch/tracker?service=police",
      "permanent": false
    },
    {
      "source": "/babuwatch/copwatchindia/report",
      "destination": "/babuwatch#seek-remedy",
      "permanent": true
    },
    {
      "source": "/babuwatch/copwatchindia/volunteer",
      "destination": "/babuwatch/about",
      "permanent": true
    },
    {
      "source": "/babuwatch/copwatchindia/:path*",
      "destination": "/babuwatch/:path*",
      "permanent": true
    },
    {
      "source": "/babuwatch/copwatch",
      "destination": "/babuwatch",
      "permanent": true
    },
    {
      "source": "/babuwatch/copwatch/:path*",
      "destination": "/babuwatch/:path*",
      "permanent": true
    },
    {
      "source": "/rights",
      "destination": "/babuwatch#seek-remedy",
      "permanent": true
    },
    {
      "source": "/remedy",
      "destination": "/babuwatch#seek-remedy",
      "permanent": true
    },
    {
      "source": "/babuwatch/rights",
      "destination": "/babuwatch#seek-remedy",
      "permanent": true
    },
    {
      "source": "/babuwatch/remedy",
      "destination": "/babuwatch#seek-remedy",
      "permanent": true
    },
    {
      "source": "/trial-court",
      "destination": "/babuwatch/tracker?level=trial",
      "permanent": true
    },
    {
      "source": "/babuwatch/trial-court",
      "destination": "/babuwatch/tracker?level=trial",
      "permanent": true
    }
  ]
}
